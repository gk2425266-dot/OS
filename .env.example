# GEMINI_API_KEY: Optional for AI Studio runtime secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (must remain 3000 in AI Studio).
PORT=3000

# ADMIN_USERNAME: Administrator login username for /admin dashboard.
ADMIN_USERNAME="anshraj"

# ADMIN_PASSWORD: Set a strong secret password in production before deploying.
ADMIN_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"

# ADMIN_SESSION_SECRET: Random 32+ character hex/string for signing HttpOnly session cookies.
ADMIN_SESSION_SECRET="CHANGE_ME_RANDOM_SESSION_SECRET"
